{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "^(curl|wget)(/|$)"
          }
        }
      ],
      "destination": "/api/ip"
    }
  ]
}
